# ===========================
# Application Settings
# ===========================
APP_NAME=Smart Medicine Availability & Intelligent Janaushadhi Recommendation System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# ===========================
# Server
# ===========================
HOST=127.0.0.1
PORT=8000

# ===========================
# MongoDB Configuration
# ===========================
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=smart_medicine_system

# ===========================
# JWT Authentication
# ===========================
SECRET_KEY=your_super_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================
# Gmail SMTP (For OTP)
# ===========================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=